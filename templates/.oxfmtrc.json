{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "ignorePatterns": ["styles/tailwind.css", "pnpm-lock.yaml"],
  "htmlWhitespaceSensitivity": "ignore",
  "overrides": [
    {
      "files": ["layouts/base.html", "pages/index.html"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
